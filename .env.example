# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Settings -> API -> JWT Settings -> "Legacy JWT secret" (HS256 projects).
# Used as a fallback if JWKS verification (the primary path) can't resolve
# a token -- see api/app/auth.py.
SUPABASE_JWT_SECRET=

# Postgres connection string used by asyncpg and the LangGraph checkpointer
DATABASE_URL=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Research
TAVILY_API_KEY=

# Frontend (api/main.py's CORS + web/.env.local both need these -- web/ has
# its own copy since NEXT_PUBLIC_* vars must live in web/.env.local to be
# bundled into the browser build)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
